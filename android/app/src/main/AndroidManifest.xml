<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Native Java owns all network I/O (ADR 0002); the WebView itself never
         makes a request. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Desk Panel"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- Landscape is pinned here rather than left to the sensor: the phone
             lies in a stand and must not follow it. The no-action-bar theme is
             the third bar to go — WindowInsetsControllerCompat hides the status
             and navigation bars but not the activity's own title strip, and a
             dark window background keeps the panel from flashing white before
             the WebView paints (T2.3). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
