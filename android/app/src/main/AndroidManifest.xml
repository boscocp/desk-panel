<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Native Java owns all network I/O (ADR 0002); the WebView itself never
         makes a request. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The poll loop outlives the screen, so it lives in a foreground service
         (ADR 0014). specialUse is the honest type: this is not media, not a
         download, not a location fix - it is a desk panel watching for a login,
         and the platform has no category for that. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- PARTIAL_WAKE_LOCK, held only while the PC is offline. A foreground
         service does not keep the CPU awake; without this the device suspends
         with the screen and the login goes unnoticed. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- API 33+ only. On this device (API 31) the notification shows without it;
         declared so a newer phone does not silently lose the service's
         notification and, with it, the service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Desk Panel"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- sensorLandscape takes both landscape directions and refuses portrait,
             so the panel can sit either way up depending on which side the cable
             leaves the stand. It also ignores the system rotation lock, which is
             what a panel wants. The no-action-bar theme is the third bar to go —
             WindowInsetsControllerCompat hides the status and navigation bars but
             not the activity's own title strip, and a dark window background keeps
             the panel from flashing white before the WebView paints (T2.3).

             No android:configChanges, and that is measured rather than assumed.
             A 180 degree flip under sensorLandscape does NOT relaunch the activity:
             `orientation` stays `land` and screenSize, screenLayout and
             smallestScreenSize are all unchanged, so nothing the activity would
             have to declare actually changes. Verified on the device: the pid
             stayed 27861 across a flip from ROTATION_270 to ROTATION_90, and
             `panel=rendered` stayed at one occurrence, meaning the WebView never
             reloaded. Adding configChanges here would be configuration for a
             problem that does not exist. If a future change makes the panel
             portrait-capable, this stops being true and the detector is the same:
             a second `panel=rendered` in logcat after a rotation. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: nothing outside the app has any business starting it.
             MainActivity does, in onCreate, and stops it only when the panel is
             actually finishing. -->
        <service
            android:name=".PanelService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches the PC login session so the phone screen can follow it." />
        </service>
    </application>

</manifest>
